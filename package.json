{
  "name": "@whytan/dsh-semantic-ui",
  "version": "0.1.0-preview.12-dev.0",
  "description": "Bounded semantic UI for native DeepSeek Harness conversations, powered by json-render.",
  "type": "module",
  "license": "MIT",
  "author": "WhyTan00",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhyTan00/dsh-semantic-ui.git"
  },
  "engines": {
    "node": ">=24",
    "dsh": "0.2.1-rc.2"
  },
  "main": "./dist/host.js",
  "types": "./dist/types/dsh/host.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/dsh/host.d.ts",
      "default": "./dist/host.js"
    },
    "./client": "./dist/client.js",
    "./protocol": {
      "types": "./dist/types/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./package.json": "./package.json",
    "./core": {
      "types": "./dist/types/core.d.ts",
      "default": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "docs/INSTALL.zh-CN.md",
    "docs/PROTOCOL.md",
    "docs/VALIDATION.zh-CN.md",
    "docs/OVERVIEW.zh-CN.md",
    "docs/UPSTREAM.zh-CN.md",
    "docs/GENUI.zh-CN.md",
    "docs/MATURITY.zh-CN.md",
    "docs/evidence/*.json",
    "docs/evidence/*.png",
    "docs/evidence/natural/README.md",
    "docs/generated",
    "docs/natural-question-results.json",
    "fixtures/questions.json",
    "!docs/evidence/install.json",
    "SKILL.md",
    "cordis.patch.yml",
    "docs/research",
    "docs/evidence/dsh-genui-LICENSE.txt",
    "docs/TEMPLATES.zh-CN.md",
    "fixtures/template-questions.json",
    "docs/QUALITY.zh-CN.md",
    "plugin.json",
    "skills",
    "docs/CODEX.zh-CN.md",
    "docs/SEMANTICS.zh-CN.md",
    "docs/GROUNDING-FOLLOWUP.zh-CN.md",
    "docs/CHART-COMPARISON.zh-CN.md",
    "docs/DECLARATION-CHECKS.zh-CN.md",
    "docs/SOURCE-CHECKS.zh-CN.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-connection"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run test:release-isolation && npm run build",
    "docs:generate": "tsx scripts/generate-docs.ts",
    "release:pack": "node scripts/release.mjs",
    "test:host": "node tests/host-lifecycle.mjs",
    "test:history": "HISTORY_ONLY=1 node tests/host-lifecycle.mjs",
    "test:compat": "node tests/host-compat.mjs",
    "research:check": "node scripts/research-check.mjs",
    "research:generate": "node scripts/research-check.mjs --write",
    "test:release-isolation": "node tests/release-isolation.mjs",
    "test:chart-host": "CHART_CHECK_ONLY=1 node tests/host-lifecycle.mjs",
    "test:consistency-host": "CONSISTENCY_CHECK_ONLY=1 node tests/host-lifecycle.mjs",
    "test:installed-consistency": "node tests/installed-consistency.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@deepseek-ai/schemastery": "3.18.5",
    "@json-render/core": "0.21.1",
    "@json-render/react": "0.21.1",
    "@xyflow/react": "12.12.0",
    "echarts": "6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.27.4",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "packageManager": "pnpm@10.32.1",
  "bin": {
    "semantic-ui-checks": "./dist/mcp.js"
  }
}
