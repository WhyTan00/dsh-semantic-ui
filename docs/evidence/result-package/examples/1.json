  "content": {
    "view": {
      "protocolVersion": "1.4",
      "displayId": "portable-native-1",
      "revision": 1,
      "summary": "Managed hosting fits a small operations budget; the recommendation changes when private networking is required.",
      "presentation": {
        "version": 1,
        "theme": {
          "mode": "light",
          "palette": "ocean",
          "font": "system",
          "density": "comfortable",
          "textSize": "standard"
        },
        "layout": {
          "direction": "auto"
        }
      },
      "component": "DecisionExplorer",
      "payload": {
        "title": "完整结果合成样本 1",
        "dimensions": [
          {
            "id": "operations",
            "label": "Operations"
          },
          {
            "id": "network",
            "label": "Private network"
          },
          {
            "id": "price",
            "label": "Price"
          }
        ],
        "options": [
          {
            "id": "managed",
            "label": "Managed platform",
            "values": {
              "operations": "Provider handles updates",
              "network": "Unavailable on this fictional plan",
              "price": null
            },
            "advantages": [
              "Low maintenance"
            ],
            "disadvantages": [
              "Limited network control"
            ],
            "suitableWhen": "A small team without private network requirements.",
            "evidence": [
              "Fictional plan facts."
            ]
          },
          {
            "id": "vm",
            "label": "Virtual machine",
            "values": {
              "operations": "Team maintains the operating system",
              "network": "Supported",
              "price": null
            },
            "advantages": [
              "Network control"
            ],
            "disadvantages": [
              "Maintenance work"
            ],
            "suitableWhen": "Private networking is required and the team can maintain it.",
            "evidence": [
              "Fictional plan facts."
            ]
          }
        ],
        "inputs": [
          {
            "id": "private",
            "label": "Require private networking",
            "type": "boolean",
            "initial": false,
            "expectedEffect": "hard-and-preference"
          }
        ],
        "rules": [
          {
            "id": "simple",
            "priority": 10,
            "when": {
              "mode": "all",
              "clauses": [
                {
                  "input": "private",
                  "op": "eq",
                  "value": false
                }
              ]
            },
            "recommend": [
              "managed"
            ],
            "reason": "No private network is required; prioritize reduced maintenance.",
            "origin": "model-judgment",
            "evidence": [
              "Maintenance capabilities above."
            ]
          },
          {
            "id": "private-rule",
            "priority": 20,
            "when": {
              "mode": "all",
              "clauses": [
                {
                  "input": "private",
                  "op": "eq",
                  "value": true
                }
              ]
            },
            "recommend": [
              "vm"
            ],
            "reason": "Private networking is required.",
            "origin": "given",
            "evidence": [
              "The managed fictional plan has no private network support."
            ]
          }
        ],
        "constraints": [
          {
            "id": "network-hard",
            "optionId": "managed",
            "when": {
              "mode": "all",
              "clauses": [
                {
                  "input": "private",
                  "op": "eq",
                  "value": true
                }
              ]
            },
            "reason": "The plan cannot satisfy the required private network.",
            "evidence": []
          }
        ]
      }
    },
