    "view": {
      "protocolVersion": "1.4",
      "displayId": "local-condition-form",
      "revision": 1,
      "summary": "公开合成比较：托管方案容量120，自管方案容量300；自管维护可用性原为未知。本地表单不会补齐未知来源。",
      "presentation": {
        "version": 1,
        "theme": {
          "mode": "light",
          "palette": "ocean",
          "font": "system",
          "density": "comfortable",
          "textSize": "standard"
        },
        "layout": {
          "direction": "auto"
        }
      },
      "component": "DecisionExplorer",
      "payload": {
        "title": "多条件本地试算（公开合成）",
        "dimensions": [
          {
            "id": "network",
            "label": "支持专用网络",
            "kind": "boolean",
            "semanticRole": "capability-support"
          },
          {
            "id": "maintenance",
            "label": "需要自行维护",
            "kind": "boolean",
            "semanticRole": "resource-need"
          },
          {
            "id": "price",
            "label": "价格（未知）"
          },
          {
            "id": "capacity",
            "label": "处理能力",
            "kind": "number",
            "unit": "次/秒"
          }
        ],
        "options": [
          {
            "id": "managed",
            "label": "托管方案",
            "values": {
              "network": false,
              "maintenance": false,
              "price": null,
              "capacity": 120
            },
            "advantages": [],
            "disadvantages": [],
            "suitableWhen": "逐项核对本地条件；价格未知，无偏好排序。",
            "evidence": [
              "仅限公开合成输入。"
            ]
          },
          {
            "id": "vm",
            "label": "自管方案",
            "values": {
              "network": true,
              "maintenance": true,
              "price": null,
              "capacity": 300
            },
            "advantages": [],
            "disadvantages": [],
            "suitableWhen": "逐项核对本地条件；价格未知，无偏好排序。",
            "evidence": [
              "仅限公开合成输入。"
            ]
          }
        ],
        "inputs": [
          {
            "id": "networkNeeded",
            "label": "需要专用网络",
            "type": "boolean",
            "initial": false,
            "semanticRole": "capability-need",
            "expectedEffect": "hard"
          },
          {
            "id": "teamAvailable",
            "label": "维护人员可用",
            "type": "boolean",
            "initial": null,
            "semanticRole": "resource-available",
            "expectedEffect": "hard"
          },
          {
            "id": "demand",
            "label": "需求量",
            "type": "number",
            "unit": "次/秒",
            "initial": 100,
            "expectedEffect": "hard"
          },
          {
            "id": "mode",
            "label": "工作模式",
            "type": "choice",
            "choices": [
              "常规",
              "高并发"
            ],
            "initial": "常规",
            "expectedEffect": "hard"
          }
        ],
        "rules": [],
        "constraints": [
          {
            "id": "high-mode",
            "optionId": "managed",
            "when": {
              "mode": "all",
              "clauses": [
                {
                  "input": "mode",
                  "op": "eq",
                  "value": "高并发"
                }
              ]
            },
            "reason": "合成声明：高并发模式排除托管方案。",
            "evidence": [
              "合成规则，仅用于本地表单验证。"
            ]
          }
        ],
        "requirements": [
          {
            "id": "private-network",
            "dimension": "network",
            "input": "networkNeeded",
            "relation": "supports"
          },
          {
            "id": "team-maintenance",
            "dimension": "maintenance",
            "input": "teamAvailable",
            "relation": "requires-availability"
          },
          {
            "id": "capacity",
            "dimension": "capacity",
            "input": "demand",
            "relation": "at-least"
          }
        ]
      }
    },
